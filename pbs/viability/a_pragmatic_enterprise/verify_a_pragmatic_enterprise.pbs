#!/bin/bash
#
## Required PBS Directives --------------------------------------
#PBS -A OUSAF55282GVD
#PBS -q standard
#PBS -l walltime=72:00:00
#PBS -l select=1:ncpus=92:mpiprocs=1
#PBS -l place=exclhost
#
## Optional PBS Directives --------------------------------------
#PBS -N verify_a_pragmatic_enterprise
#PBS -j oe
#PBS -o logs/viability/verify_a_pragmatic_enterprise.out
#PBS -e logs/viability/verify_a_pragmatic_enterprise.err
#
## Execution Block ----------------------------------------------
JOBID=$PBS_JOBID

PROJECT_DIR="$HOME/absorption_model"
cd "${PBS_O_WORKDIR:-$PROJECT_DIR}" || cd "$PROJECT_DIR" || exit 1

source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate absorption

echo "Checking Environment..."
which python
python --version

export PYTHONUNBUFFERED=1

mkdir -p "$PROJECT_DIR/logs/viability"
export PYTHONPATH="$PROJECT_DIR${PYTHONPATH:+:$PYTHONPATH}"

python -u -m src.viability.cli verify-candidates \
  --config configs/viability/a_pragmatic_enterprise.yaml \
  --candidates outputs/viability/rap_a_pragmatic_enterprise/search/candidate_policies.csv \
  --output-dir outputs/viability/rap_a_pragmatic_enterprise/verify \
  --workers 64

