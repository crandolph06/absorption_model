#!/bin/bash
#
## Required PBS Directives --------------------------------------
#PBS -A OUSAF55282GVD
#PBS -q standard
#PBS -l walltime=72:00:00
#PBS -l select=1:ncpus=92:mpiprocs=1
#PBS -l place=exclhost
#
## Optional PBS Directives --------------------------------------
#PBS -N holdout_c_pragmatic_enterprise
#PBS -j oe
#PBS -o logs/viability/holdout_c_pragmatic_enterprise.out
#PBS -e logs/viability/holdout_c_pragmatic_enterprise.err
#
## Execution Block ----------------------------------------------
JOBID=$PBS_JOBID

PROJECT_DIR="$HOME/absorption_model"
cd "${PBS_O_WORKDIR:-$PROJECT_DIR}" || cd "$PROJECT_DIR" || exit 1

source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate absorption

echo "Checking Environment..."
which python
python --version

export PYTHONUNBUFFERED=1

mkdir -p "$PROJECT_DIR/logs/viability"
export PYTHONPATH="$PROJECT_DIR${PYTHONPATH:+:$PYTHONPATH}"

python -u -m src.viability.cli select-holdout \
  --config configs/viability/c_pragmatic_enterprise.yaml \
  --evaluations outputs/viability/rap_c_pragmatic_enterprise/doe_128/evaluations.parquet \
  --output outputs/viability/rap_c_pragmatic_enterprise/doe_128/holdout.parquet

